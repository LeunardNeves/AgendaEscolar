<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_school_art"
    android:padding="24dp">

    <!-- Conteúdo Centralizado (Ícone, Título e Subtítulo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Ícone do Chapéu de Formatura -->
        <ImageView
            android:id="@+id/imgCapelo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:contentDescription="Chapéu Académico"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="#1E3A8A" />

        <!-- Título Principal -->
        <TextView
            android:id="@+id/txtTituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Agenda Escolar"
            android:textColor="#0F172A"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/txtSubtituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sua escola mais conectada"
            android:textColor="#1E293B"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Parte Inferior (Botão Entrar e Cadastro) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Botão Entrar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnComecar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_dark_blue"
            android:text="Entrar      →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Texto de Primeiro Acesso -->
        <TextView
            android:id="@+id/txtJaTenhoConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="6dp"
            android:text="Primeiro acesso? Cadastre-se aqui"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>