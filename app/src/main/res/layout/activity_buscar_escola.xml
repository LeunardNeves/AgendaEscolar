<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ONDA AZUL INFERIOR -->
    <View
        android:id="@+id/ondaInferior"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_wave_light" />

    <!-- CONTEÚDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="32dp"
            android:paddingBottom="110dp">

            <!-- BARRA SUPERIOR -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <!-- BOTÃO VOLTAR -->
                <ImageView
                    android:id="@+id/btnVoltarEscola"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Voltar"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#1E3A8A" />

                <!-- BOTÃO LER QR CODE -->
                <LinearLayout
                    android:id="@+id/btnLerQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="25dp"
                    android:gravity="end"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_qr_code_blue"
                        android:contentDescription="@null" />

                </LinearLayout>

            </RelativeLayout>

            <!-- ILUSTRAÇÃO DA ESCOLA -->

            <!-- TÍTULO -->

            <ImageView
                android:id="@+id/imgEscola"
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:layout_marginTop="20dp"
                android:contentDescription="Ilustração de uma escola"
                android:scaleType="fitCenter"
                android:src="@drawable/ilustracao_escola" />

            <TextView
                android:id="@+id/txtTituloEscola"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Encontre sua escola"
                android:textColor="#0F172A"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- SUBTÍTULO -->
            <TextView
                android:id="@+id/txtSubtituloEscola"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Digite o código da instituição fornecido pela escola."
                android:textColor="#475569"
                android:textSize="15sp" />

            <!-- RÓTULO -->
            <TextView
                android:id="@+id/txtLabelCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:layout_marginStart="12dp"
                android:text="Código da escola"
                android:textColor="#1E3A8A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- CAMPO CÓDIGO DA ESCOLA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_campo_cadastro"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_school_blue"
                    android:contentDescription="Código da escola"
                    app:tint="#1E40AF" />

                <EditText
                    android:id="@+id/edtCodigoEscola"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:background="@android:color/transparent"
                    android:hint="Ex.: ESC001"
                    android:inputType="textCapCharacters"
                    android:singleLine="true"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- BOTÃO BUSCAR ESCOLA -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBuscarEscola"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_btn_dark_blue"
                android:text="Buscar escola"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>